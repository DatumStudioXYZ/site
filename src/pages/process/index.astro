---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import CallToAction from "../../components/CallToAction.astro";
import { processSteps } from "../../data/process";
import { breadcrumbs } from "../../lib/structured-data";
---
<Layout
  title="Process — Datum Studio"
  description="Datum's four-step process: Understand, Establish, Integrate, Refine. A clear path from the first conversation to a space that works beautifully."
  canonical="/process/"
  jsonLd={[{
    "@context": "https://schema.org", "@type": "HowTo", name: "Datum Studio Process",
    description: "Four steps to a thoughtful, integrated space: Understand, Establish, Integrate, Refine.",
    step: processSteps.map((step) => ({ "@type": "HowToStep", name: step.title, text: step.summary })),
  }, breadcrumbs([{ name: "Home", path: "/" }, { name: "Process", path: "/process/" }])]}
>
  <PageHero kicker="Our process" title="Find the datum. Design from there." intro="Four steps from the first conversation to a space that works beautifully." theme="dark" />
  {processSteps.map((step) => (
    <section class="process-step section-pad">
      <div class="process-step-header"><span class="process-step-number">{step.number}</span><h2>{step.title}</h2><p class="process-step-summary">{step.summary}</p></div>
      <div class="process-step-body">
        <p class="process-step-lead">{step.description}</p>
        <div class="process-step-details"><p class="section-kicker">What happens</p><ul>{step.whatHappens.map((item) => <li>{item}</li>)}</ul></div>
        <div class="process-step-experience"><p class="section-kicker">How it feels</p><p>{step.clientExperience}</p></div>
      </div>
    </section>
  ))}
  <CallToAction kicker="Ready to begin?" title="Every project starts with a conversation." />
</Layout>
