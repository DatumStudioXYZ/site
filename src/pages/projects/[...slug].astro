---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import ContentDetail from "../../components/ContentDetail.astro";
import Tags from "../../components/Tags.astro";
import { breadcrumbs, organization } from "../../lib/structured-data";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }: { data: CollectionEntry<"projects">["data"] }) => !data.draft);

  return projects.map((project: CollectionEntry<"projects">) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project }: { project: CollectionEntry<"projects"> } = Astro.props;
const { Content } = await render(project);

const heading = project.data.title.replace(/ — Datum Studio$/, "");

const statusLabel: Record<string, string> = {
  "in-progress": "In progress",
  completed: "Completed",
  archived: "Archived",
};

const projectJsonLd = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: heading,
  description: project.data.description,
  datePublished: project.data.pubDate.toISOString(),
  dateModified: project.data.updatedDate?.toISOString() ?? project.data.pubDate.toISOString(),
  author: organization,
  keywords: project.data.tags.join(", "),
  inLanguage: "en",
};

const breadcrumbJsonLd = breadcrumbs([{ name: "Home", path: "/" }, { name: "Projects", path: "/projects/" }, { name: heading, path: `/projects/${project.id}/` }]);
---

<Layout
  title={project.data.title}
  description={project.data.description}
  canonical={`/projects/${project.id}/`}
  jsonLd={[projectJsonLd, breadcrumbJsonLd]}
>
  <ContentDetail kind="project" heading={heading} description={project.data.description} backHref="/projects/" backLabel="All projects" sharePath={`/projects/${project.id}/`}>
      <div slot="meta" class="content-header-meta">
        <span class={`project-status project-status--${project.data.status}`}>
          <i></i> {statusLabel[project.data.status]}
        </span>
        <time>{project.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</time>
        <Tags tags={project.data.tags} />
      </div>
      <Content />
  </ContentDetail>
</Layout>
