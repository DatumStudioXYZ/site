---
import { getCollection, getEntry, render, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import ContentDetail from "../../components/ContentDetail.astro";
import Tags from "../../components/Tags.astro";
import { breadcrumbs } from "../../lib/structured-data";
import { site } from "../../data/site";

export async function getStaticPaths() {
  const articles = await getCollection("articles", ({ data }: { data: CollectionEntry<"articles">["data"] }) => !data.draft);

  return articles.map((article: CollectionEntry<"articles">) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article }: { article: CollectionEntry<"articles"> } = Astro.props;
const { Content } = await render(article);
const author = await getEntry(article.data.author);

if (!author) {
  throw new Error(`Missing author entry for article: ${article.id}`);
}

const heading = article.data.title.replace(/ — Datum Studio$/, "");
const authorUrl = `/authors/${author.data.slug}/`;

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: heading,
  description: article.data.description,
  datePublished: article.data.pubDate.toISOString(),
  dateModified: article.data.updatedDate?.toISOString() ?? article.data.pubDate.toISOString(),
  author: {
    "@type": "Person",
    name: author.data.name,
    url: `${site.url}${authorUrl}`,
    image: author.data.avatar,
    ...(author.data.social ? { sameAs: Object.values(author.data.social) } : {}),
  },
  publisher: {
    "@type": "Organization",
    name: site.name,
    url: site.url,
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": `${site.url}/articles/${article.id}/`,
  },
  keywords: article.data.tags.join(", "),
  inLanguage: "en",
};

const breadcrumbJsonLd = breadcrumbs([{ name: "Home", path: "/" }, { name: "Articles", path: "/articles/" }, { name: heading, path: `/articles/${article.id}/` }]);
---

<Layout
  title={article.data.title}
  description={article.data.description}
  canonical={`/articles/${article.id}/`}
  ogType="article"
  articlePublished={article.data.pubDate.toISOString()}
  articleTags={article.data.tags}
  jsonLd={[articleJsonLd, breadcrumbJsonLd]}
>
  <ContentDetail kind="article" heading={heading} description={article.data.description} backHref="/articles/" backLabel="All articles" sharePath={`/articles/${article.id}/`}>
      <div slot="meta" class="content-header-meta">
        <time>{article.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</time>
        <Tags tags={article.data.tags} />
      </div>
      <a slot="author" class="article-author" href={authorUrl}>
        <img src={author.data.avatar} alt="" loading="lazy" />
        <span>By {author.data.name}</span>
      </a>
      {article.data.updatedDate && (
        <p slot="after-heading" class="article-updated">Updated {article.data.updatedDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</p>
      )}
      <Content />
  </ContentDetail>
</Layout>
