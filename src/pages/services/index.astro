---
import Layout from "../../layouts/Layout.astro";
import { getCollection, getEntry, type CollectionEntry } from "astro:content";
import PageHero from "../../components/PageHero.astro";
import CallToAction from "../../components/CallToAction.astro";
import { breadcrumbs } from "../../lib/structured-data";
const siteEntry = await getEntry("site", "site");
if (!siteEntry) throw new Error("Missing site content entry");
const site = siteEntry.data;
const serviceEntries: CollectionEntry<"services">[] = await getCollection("services");
const services = serviceEntries.map((entry: CollectionEntry<"services">) => ({ slug: entry.id, ...entry.data })).sort((a, b) => a.number.localeCompare(b.number));
---
<Layout
  title="Services — Datum Studio"
  description="Commission Datum for workspace design, home organisation, custom pieces, or systems planning. Start with a conversation to define the scope of your project."
  canonical="/services/"
  jsonLd={[{
    "@context": "https://schema.org", "@type": "CollectionPage", name: "Datum Studio Services",
    url: "https://datumstudio.xyz/services/",
    description: "Commissions for workspace design, home organisation, custom pieces, and systems planning. Each project starts with a conversation to define its scope.",
    mainEntity: { "@type": "ItemList", itemListElement: services.map((service) => ({ "@type": "ListItem", name: service.title, description: service.tagline })) },
  }, breadcrumbs([{ name: "Home", path: "/" }, { name: "Services", path: "/services/" }])]}
>
  <PageHero kicker="What we do" title="Defined by outcomes, not trades." intro="Open for commissions, from a workspace that needs a better layout to a custom piece or a clearer plan for the whole project." />
  <section class="service-detail section-pad">
    <div class="commission-intro-header">
      <h2>Start with the problem.</h2>
      <p class="service-detail-tagline">You do not need a finished brief to get in touch.</p>
    </div>
    <div class="service-detail-body">
      <div class="service-detail-description"><p class="service-detail-lead">Tell us about the space or routine, what is getting in the way, and what you hope to change. Include your location and any timing or budget you have in mind.</p></div>
      <div class="service-detail-approach"><p>The first conversation helps identify what the project needs: a layout, a custom piece, a storage system, or a plan for work in stages. Each commission is scoped and priced individually. Deliverables, fees, and timing are agreed for your project.</p></div>
      <div class="service-detail-includes"><p>Projects in {site.serviceArea.join(", ")}, and remote enquiries are welcome. We’ll discuss whether the work calls for a site visit or can be handled remotely.</p></div>
    </div>
  </section>
  {services.map((service) => (
    <section id={service.slug} class="service-detail section-pad">
      <div class="service-detail-header">
        <span class="service-detail-number">{service.number}</span><h2>{service.title}</h2><p class="service-detail-tagline">{service.tagline}</p>
      </div>
      <div class="service-detail-body">
        <div class="service-detail-description"><p class="service-detail-lead">{service.description}</p></div>
        <div class="service-detail-approach"><p class="section-kicker">Our approach</p><p>{service.approach}</p></div>
        <div class="service-detail-includes"><p class="section-kicker">What this includes</p><ul>{service.includes.map((item: string) => <li>{item}</li>)}</ul></div>
      </div>
    </section>
  ))}
  <CallToAction />
</Layout>

<style>
  .commission-intro-header { margin-bottom: 48px; }
  .commission-intro-header h2 { font-size: clamp(36px, 3.6vw, 52px); font-weight: 560; letter-spacing: -.035em; line-height: 1.04; margin: 0 0 20px; }
</style>
