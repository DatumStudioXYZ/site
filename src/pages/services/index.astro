---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import CallToAction from "../../components/CallToAction.astro";
import { services } from "../../data/services";
import { breadcrumbs } from "../../lib/structured-data";
---
<Layout
  title="Services — Datum Studio"
  description="Datum offers four integrated services: Work Better, Live Better, Build Better, and Think Better. Architecture, craft, and technology for spaces that work beautifully."
  canonical="/services/"
  jsonLd={[{
    "@context": "https://schema.org", "@type": "CollectionPage", name: "Datum Studio Services",
    url: "https://datumstudio.xyz/services/",
    description: "Four integrated services for thoughtful spaces: Work Better, Live Better, Build Better, Think Better.",
    mainEntity: { "@type": "ItemList", itemListElement: services.map((service) => ({ "@type": "ListItem", name: service.title, description: service.tagline })) },
  }, breadcrumbs([{ name: "Home", path: "/" }, { name: "Services", path: "/services/" }])]}
>
  <PageHero kicker="What we do" title="Defined by outcomes, not trades." intro="One studio thinking across the room, the object, and the technology inside it." />
  {services.map((service) => (
    <section class="service-detail section-pad">
      <div class="service-detail-header">
        <span class="service-detail-number">{service.number}</span><h2>{service.title}</h2><p class="service-detail-tagline">{service.tagline}</p>
      </div>
      <div class="service-detail-body">
        <div class="service-detail-description"><p class="service-detail-lead">{service.description}</p></div>
        <div class="service-detail-approach"><p class="section-kicker">Our approach</p><p>{service.approach}</p></div>
        <div class="service-detail-includes"><p class="section-kicker">What this includes</p><ul>{service.includes.map((item) => <li>{item}</li>)}</ul></div>
      </div>
    </section>
  ))}
  <CallToAction kicker="Not sure where to start?" title="Let's figure it out together." />
</Layout>
