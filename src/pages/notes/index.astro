---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import ContentList from "../../components/ContentList.astro";
import Tags from "../../components/Tags.astro";

const allNotes = await getCollection("notes", ({ data }: { data: CollectionEntry<"notes">["data"] }) => !data.draft);

const sortedNotes = allNotes.sort(
  (a: CollectionEntry<"notes">, b: CollectionEntry<"notes">) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="Notes — Datum Studio" description="Quick updates, sketches, failed prototypes, and questions from Datum Studio.">
  <PageHero kicker="Notes" title="Quick updates, sketches, and questions." />
  <ContentList kind="notes" empty={sortedNotes.length === 0} emptyMessage="No notes published yet. Check back soon.">
    {sortedNotes.map((note: CollectionEntry<"notes">) => (
      <li>
            <a href={`/notes/${note.id}/`} class="note-card">
              {note.data.image && (
                <img class="note-card-image" src={note.data.image.src} alt={note.data.image.alt} loading="lazy" />
              )}
              <div class="note-card-meta">
                <time>{note.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</time>
                <Tags tags={note.data.tags} />
              </div>
              <h2>{note.data.title}</h2>
            </a>
      </li>
    ))}
  </ContentList>
</Layout>
