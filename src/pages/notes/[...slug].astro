---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import ContentDetail from "../../components/ContentDetail.astro";
import Tags from "../../components/Tags.astro";
import { breadcrumbs, organization } from "../../lib/structured-data";
import { site } from "../../data/site";

export async function getStaticPaths() {
  const notes = await getCollection("notes", ({ data }: { data: CollectionEntry<"notes">["data"] }) => !data.draft);

  return notes.map((note: CollectionEntry<"notes">) => ({
    params: { slug: note.id },
    props: { note },
  }));
}

const { note }: { note: CollectionEntry<"notes"> } = Astro.props;
const { Content } = await render(note);

const heading = note.data.title.replace(/ — Datum Studio$/, "");

const noteJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: heading,
  datePublished: note.data.pubDate.toISOString(),
  author: organization,
  publisher: organization,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": `${site.url}/notes/${note.id}/`,
  },
  keywords: note.data.tags.join(", "),
  ...(note.data.image ? { image: note.data.image.src } : {}),
  inLanguage: "en",
};

const breadcrumbJsonLd = breadcrumbs([{ name: "Home", path: "/" }, { name: "Notes", path: "/notes/" }, { name: heading, path: `/notes/${note.id}/` }]);
---

<Layout
  title={`${note.data.title} — Datum Studio`}
  description={note.data.title}
  canonical={`/notes/${note.id}/`}
  ogImage={note.data.image?.src}
  ogType="article"
  articlePublished={note.data.pubDate.toISOString()}
  articleTags={note.data.tags}
  jsonLd={[noteJsonLd, breadcrumbJsonLd]}
>
  <ContentDetail kind="note" heading={heading} backHref="/notes/" backLabel="All notes" sharePath={`/notes/${note.id}/`}>
      <div slot="meta" class="content-header-meta">
        <time>{note.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</time>
        <Tags tags={note.data.tags} />
      </div>
      {note.data.image && (
        <figure class="note-lead-image">
          <img src={note.data.image.src} alt={note.data.image.alt} />
          {note.data.image.caption && <figcaption>{note.data.image.caption}</figcaption>}
        </figure>
      )}
      <Content />
  </ContentDetail>
</Layout>
