---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm.astro";
import TechnicalFrame from "../components/TechnicalFrame.astro";
import { services } from "../data/services";
import { conversationCopy, site } from "../data/site";
---

<Layout
  title="Datum Studio | Thoughtful spaces, custom pieces, practical systems"
  description={site.description}
  jsonLd={[
    {
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      name: "Datum Studio",
      url: "https://datumstudio.xyz",
      description: site.description,
      email: site.email,
      areaServed: site.serviceArea,
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: "Datum Studio Services",
        itemListElement: services.map((service) => ({ "@type": "Offer", itemOffered: { "@type": "Service", name: service.title, description: service.tagline } })),
      },
    },
  ]}
>
  <section class="hero" id="top">
    <div class="hero-copy">
      <p class="eyebrow">Architecture · Craft · Technology</p>
      <h1>Spaces, objects, and systems for the way you live.</h1>
      <p class="hero-intro">Open for commissions: thoughtful rooms, custom pieces, and practical technology. Bring the space, routine, or problem you want to improve.</p>
      <div class="hero-actions">
        <a class="button button-primary" href="#contact">{conversationCopy.label} <span>↗</span></a>
        <a class="text-link" href="#reference">How Datum works <span>↓</span></a>
      </div>
      <p class="location"><span></span> {site.serviceAreaLabel}</p>
    </div>
    <TechnicalFrame class="hero-image" src="https://images.datumstudio.xyz/workshop-wide.avif?v=20260730" alt="A residential workshop being studied before redesign and organization" caption="Existing conditions · Workshop study" />
  </section>

  <section class="project section-pad" id="project">
    <div class="project-title">
      <div>
        <p class="section-kicker">Project · 01 · In progress</p>
        <h2>A workshop with a clear point of reference.</h2>
      </div>
      <p>Part of Gavin’s own home renovation, this workshop is an ongoing personal project. The design starts with a practical problem: tools without homes, storage without memory, and floor space buried beneath competing needs.</p>
    </div>
    <div class="project-gallery">
      <TechnicalFrame class="project-main" src="https://images.datumstudio.xyz/workshop-floor.avif?v=20260730" alt="Open floor area emerging during a garage workshop reorganization" caption="Establishing the working floor" />
      <div class="project-side">
        <TechnicalFrame src="https://images.datumstudio.xyz/workshop-storage.avif?v=20260730" alt="Tools and storage awaiting a new organized system" caption="Inventory before infrastructure" />
        <div class="project-note">
          <span class="status"><i></i> Design in progress</span>
          <p>The working hypothesis: give each tool and material a defined home, then make that location easy to recover. The design combines task zones, overhead tire storage, labelled totes, and a searchable QR inventory.</p>
          <p>A workshop progress report is being prepared.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="datum-story section-pad" id="reference">
    <div class="story-heading">
      <p class="section-kicker">The reference point</p>
      <h2>The invisible line that makes everything fit.</h2>
    </div>
    <div class="story-copy">
      <p>A datum is the line, plane, or point from which everything else is measured. We begin with how you want to live, then make the room, the object, and the technology answer to the same reference point.</p>
      <p class="story-close">The aim is not more stuff to notice. It is less friction in the life around it.</p>
    </div>
  </section>

  <section class="services section-pad" id="services">
    <div class="section-heading">
      <p class="section-kicker">What we do</p>
      <h2>Defined by outcomes,<br />not trades.</h2>
      <p>One studio thinking across the room, the object, and the technology inside it.</p>
    </div>
    <div class="service-grid">
      {services.map((service) => (
        <article class="service-card">
          <span class="service-number">{service.number}</span>
          <h3><a href={`/services/#${service.slug}`}>{service.title}</a></h3>
          <p>{service.tagline}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="contact section-pad" id="contact">
    <div class="contact-copy">
      <p class="section-kicker">{conversationCopy.label}</p>
      <h2>{conversationCopy.title}</h2>
      <p>{conversationCopy.body}</p>
      <p class="contact-meta">Serving {site.serviceArea.join(", ")}, and remote projects.</p>
    </div>
    <ContactForm />
  </section>
</Layout>
