---
import "@fontsource-variable/ibm-plex-sans/wdth.css";
import { ClientRouter } from "astro:transitions";
import { getEntry } from "astro:content";
import Wordmark from "../components/Wordmark.astro";
import SocialLinks from "../components/SocialLinks.astro";
import "../styles/global.css";

const siteEntry = await getEntry("site", "site");
if (!siteEntry) throw new Error("Missing site content entry");
const { conversationCopy, socialLinks, ...site } = siteEntry.data;

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  jsonLd?: Record<string, any>[];
  articlePublished?: string;
  articleTags?: string[];
}

const {
  title,
  description = site.description,
  canonical = Astro.url.href,
  ogImage = site.defaultImage,
  ogType = "website",
  jsonLd = [],
  articlePublished,
  articleTags = [],
} = Astro.props;


const year = new Date().getFullYear();
const siteName = site.name;
const absoluteOgImage = new URL(ogImage, Astro.site).href;
const absoluteCanonical = new URL(canonical, Astro.site).href;
const normalizePath = (path: string) => path.replace(/\/+$/, "") || "/";
const currentPath = normalizePath(Astro.url.pathname);

const defaultJsonLd: Record<string, any>[] = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: siteName,
    url: Astro.site?.href,
    logo: site.logo,
    description: site.description,
    email: site.email,
    areaServed: {
      "@type": "GeoCircle",
      name: site.serviceArea.join(", "),
    },
    knowsAbout: [
      "Architecture",
      "Interior Design",
      "Custom Millwork",
      "Home Automation",
      "Systems Thinking",
      "Workshop Design",
      "Organization Design",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: siteName,
    url: Astro.site?.href,
    description: site.tagline,
    publisher: {
      "@type": "Organization",
      name: siteName,
    },
  },
];

const allJsonLd = [...defaultJsonLd, ...jsonLd];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="preload" href="/fonts/ibm-plex-sans-latin-wdth-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#3f4a3d" />
    <link rel="icon" type="image/avif" href="https://images.datumstudio.xyz/favicon.avif" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/avif" href="https://images.datumstudio.xyz/favicon-dark.avif" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={absoluteCanonical} />
    <link rel="alternate" type="application/rss+xml" title={`${siteName} — Articles`} href="/rss.xml" />
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={absoluteCanonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_CA" />
    {ogType === "article" && articlePublished && (
      <meta property="article:published_time" content={articlePublished} />
    )}
    {ogType === "article" && articleTags.length > 0 && (
      articleTags.map((tag) => (
        <meta property="article:tag" content={tag} />
      ))
    )}
    {ogType === "article" && (
      <meta property="article:author" content={siteName} />
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />

    <!-- View Transitions -->
    <ClientRouter />

    <!-- Structured Data -->
    {allJsonLd.map((ld) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(ld)} />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header" transition:persist>
      <a class="wordmark" href="/" aria-label="Datum Studio home"><Wordmark /></a>
      <button class="menu-button" aria-expanded="false" aria-controls="primary-nav">Menu</button>
      <nav id="primary-nav" class="nav" aria-label="Primary navigation">
        <a href="/about/" aria-current={currentPath === "/about" ? "page" : undefined}>About</a>
        <a href="/services/" aria-current={currentPath === "/services" ? "page" : undefined}>Services</a>
        <a href="/projects/" aria-current={currentPath === "/projects" ? "page" : undefined}>Projects</a>
        <a href="/articles/" aria-current={currentPath === "/articles" ? "page" : undefined}>Articles</a>
        <a href="/process/" aria-current={currentPath === "/process" ? "page" : undefined}>Process</a>
        <a href="/#contact" class="nav-contact">{conversationCopy.label}</a>
      </nav>
    </header>

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <footer>
      <div class="footer-grid">
        <a class="wordmark footer-mark" href="/" aria-label="Datum Studio home"><Wordmark inverted /></a>
        <div class="footer-links">
          <SocialLinks links={socialLinks} />
          <a href="/#contact">{conversationCopy.label}</a>
        </div>
        <p>{site.tagline}</p>
        <p class="footer-copyright">&copy; {year} Datum Studio</p>
      </div>
    </footer>

    <script>
      interface MenuNav extends HTMLElement {
        menuController?: AbortController;
      }

      const initializeMenu = () => {
        const menuButton = document.querySelector(".menu-button");
        const nav = document.querySelector("#primary-nav");

        if (!(menuButton instanceof HTMLButtonElement) || !(nav instanceof HTMLElement)) return;

        const menuNav = nav as MenuNav;
        menuNav.menuController?.abort();
        const controller = new AbortController();
        menuNav.menuController = controller;
        document.documentElement.classList.add("menu-ready");

        const mobileQuery = window.matchMedia("(max-width: 800px)");
        const normalizePath = (path: string) => path.replace(/\/+$/, "") || "/";
        const updateCurrentPage = () => {
          const activePath = normalizePath(window.location.pathname);
          nav.querySelectorAll<HTMLAnchorElement>("a:not(.nav-contact)").forEach((link) => {
            const linkPath = normalizePath(new URL(link.href).pathname);
            link.toggleAttribute("aria-current", linkPath === activePath);
            if (linkPath === activePath) link.setAttribute("aria-current", "page");
          });
        };
        const scrollToFragment = () => {
          const fragment = decodeURIComponent(window.location.hash.slice(1));
          if (!fragment) return;

          requestAnimationFrame(() => document.getElementById(fragment)?.scrollIntoView());
        };
        const setMenu = (open: boolean, returnFocus = false) => {
          const isOpen = mobileQuery.matches && open;
          nav.classList.toggle("open", isOpen);
          nav.inert = mobileQuery.matches && !isOpen;
          menuButton.setAttribute("aria-expanded", String(isOpen));
          menuButton.textContent = isOpen ? "Close" : "Menu";

          if (returnFocus && mobileQuery.matches) menuButton.focus();
        };

        setMenu(false);
        updateCurrentPage();
        scrollToFragment();

        menuButton.addEventListener("click", () => setMenu(!nav.classList.contains("open")), { signal: controller.signal });
        nav.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setMenu(false), { signal: controller.signal }));
        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && nav.classList.contains("open")) setMenu(false, true);
        }, { signal: controller.signal });
        mobileQuery.addEventListener("change", () => setMenu(false), { signal: controller.signal });
      };

      document.addEventListener("astro:after-swap", initializeMenu);
      document.addEventListener("astro:page-load", initializeMenu);
      initializeMenu();
    </script>
  </body>
</html>
